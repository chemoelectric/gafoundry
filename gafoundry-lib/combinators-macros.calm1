(@ define "THRUSH-SYNTAX"
  "\
  (syntax-rules () \
    ((¶ . f*) \
     (syntax-rules () \
       ((µ . val*) \
        (thrush-syntax-aux f* val*)))))")(@ dnl)
(@ dnl)
(@ define "THRUSH+-SYNTAX"
  "\
  (syntax-rules () \
    ((¶ val . f*) \
     (let-syntax ((macro (thrush-syntax . f*))) \
       (macro val))))")(@ dnl)
(@ dnl)
(@ define "THRUSH*-SYNTAX"
  "\
  (syntax-rules () \
    ((¶ . val*) \
     (syntax-rules () \
       ((µ f . f*) \
        (thrush-syntax-aux (f . f*) val*)))))")(@ dnl)
(@ dnl)
(@ define "CPS-SYNTAX"
  "\
  (syntax-rules () \
    ((¶ (@ 1)) \
     (syntax-rules () \
       ((µ k . t*) \
        (k ((@ 1) . t*))))))")(@ dnl)
(@ dnl)
(@ define "UNCPS-SYNTAX"
  "\
  (syntax-rules () \
    ((¶ (@ 1)) \
     (syntax-rules () \
       ((µ . t*) \
        (let-syntax ((identity (syntax-rules () ((ι τ) τ)))) \
          ((@ 1) identity . t*))))))")(@ dnl)
(@ dnl)
(@ define "DEFINE-CPS-SYNTAX"
  "\
  (syntax-rules () \
    ((¶ name f) \
     (define-syntax name \
       (@ CPS-SYNTAX \"f\"))))")(@ dnl)
(@ dnl)
(@ define "DEFINE-UNCPS-SYNTAX"
  "\
  (syntax-rules () \
    ((¶ name f) \
     (define-syntax name \
       (@ UNCPS-SYNTAX \"f\"))))")(@ dnl)
(@ dnl)
(@ define "LAMBDA-CPS-SYNTAX~>"
  "\
  (syntax-rules () \
    ((¶ . f*) \
     (syntax-rules () \
       ((µ k . val*) \
        (lambda-cps-syntax~>-aux f* k val*)))))")(@ dnl)
(@ dnl)
(@ define "CPS-SYNTAX~>*"
  "\
  (syntax-rules () \
    ((¶ k . val*) \
     (syntax-rules () \
       ((µ f . f*) \
        (lambda-cps-syntax~>-aux (f . f*) k val*)))))")(@ dnl)
(@ dnl)
(@ define "LAMBDA-IF"
  "\
  (syntax-rules () \
    ((¶ kt kf) \
     (lambda (x) (if x kt kf))))")(@ dnl)
(@ dnl)
(@ dnl) local variables:
(@ dnl) mode: scheme
(@ dnl) coding: utf-8
(@ dnl) end:

;;;       (define slot-ref
;;;         (case-lambda
;;;           ((rec v name)
;;;            (slot-ref-using-class rec v name))
;;;           ((obj name)
;;;            (orig-slot-ref obj name))))
;;;       (define slot-set!
;;;         (case-lambda
;;;           ((rec v name value)
;;;            (slot-set-using-class! rec v name value))
;;;           ((obj name value)
;;;            (orig-slot-set! obj name value)))))
      (else
       (if #f #f)))

    ))


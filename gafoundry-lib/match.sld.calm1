(define-library (gafoundry-lib match)

  (export match
          match-lambda
          match-lambda*
          match-let
          match-let*
          match-letrec
          match-without-binding)
  (cond-expand
    (gauche (export :info-alist))
    (else))

  (import (scheme base)
          (scheme cxr))

  ;; CHICKEN 6, at least, works also with the portable R⁷RS
  ;; implementation.
  (cond-expand
    (chicken (import (only (chicken syntax)
                           er-macro-transformer)))
    (chibi (import (scheme file))
           (import (only (chibi)
                         er-macro-transformer
                         identifier?)))
    (gauche (import (only (r7rs aux)
                          :info-alist
                          er-macro-transformer
                          is-a?)
                    (only (gauche record)
                          rtd-accessor
                          rtd-mutator)))
;;;    (sagittarius (import (only (sagittarius)
;;;                               er-macro-transformer)
;;;                         (only (sagittarius clos)
;;;                               is-a?
;;;                               slot-ref-using-class
;;;                               slot-set-using-class!)
;;;                         (rename (only (sagittarius clos)
;;;                                       (slot-ref orig-slot-ref)
;;;                                       (slot-set! orig-slot-set!)))))
    (sagittarius (import (only (sagittarius)
                               er-macro-transformer)))
    (else))

  (begin

    (@ include-raw "gafoundry-lib/match.scm")

    (cond-expand
      (gauche
       (define (slot-ref rec v name)
         ((rtd-accessor rec name) v))
       (define (slot-set! rec v name value)
         ((rtd-mutator rec name) v value)))

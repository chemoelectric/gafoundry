(define-library (gafoundry-lib format)

  (import (scheme base)
          (scheme case-lambda)
          (scheme char)
          (scheme write)
          (scheme inexact)
          (scheme complex)
          (scheme cxr)
          (srfi 1))
  (cond-expand
    (chibi (import (chibi show)
                   (chibi show pretty)))
    (chicken (import (chicken pretty-print)))
    (gauche (import (gauche base)
                    (gauche keyword)))
    (sagittarius (import (pp)))
    (else))

  (export format)

  (begin

    (@ include-raw "gafoundry-lib/replacements-for-slib.scm")

    (define (provided? symb)
      (cond
        ((eq? symb 'real) #t)
        ((eq? symb 'inexact) #t)
        ((eq? symb 'complex) #t)))

    (define force-output flush-output-port)

    (cond-expand
      (chibi
       (define pretty-print
         (case-lambda
           ((obj) 
            (show (current-output-port) (pretty obj)))
           ((obj port) 
            (show port (pretty obj))))))
      (gauche
       (define pretty-print
         (case-lambda
           ((obj) (pprint obj))
           ((obj port) (pprint obj :port port)))))
      (sagittarius pretty-print pp)
      (else pretty-print write))

    (@ dnl)
    (@ dnl) Sagittarius is still at its center an R⁶RS implementation,
    (@ dnl) and does not want to have redefinitions. So we disable the
    (@ dnl) definitions of string-upcase and string-downcase.
    (@ dnl)
    (@ include-raw
       "sed \
        -e 's/^\\([[:space:]]*\x28;require\\(\\|-if\\) \\)/;;;\\1/' \
        -e 's/\x28;define \x28;string-upcase /\x28;define \x28;string-upcase-NOTUSED /' \
        -e 's/\x28;define \x28;string-downcase /\x28;define \x28;string-downcase-NOTUSED /' \
        gafoundry-lib/strcase.scm \
        gafoundry-lib/format.scm|")

    ))

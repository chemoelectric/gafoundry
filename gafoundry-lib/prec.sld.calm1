(define-library (gafoundry-lib prec)

  (import (scheme base)
          (scheme char)
          (scheme write)
          (scheme lazy)
          (scheme cxr)
          (srfi 1))

  (export tok:char-group
          tok:decimal-digits
          tok:upper-case
          tok:lower-case
          tok:whitespaces
          prec:make-nud
          prec:make-led
          prec:delim
          prec:nofix
          prec:prefix
          prec:infix
          prec:nary
          prec:postfix
          prec:prestfix
          prec:commentfix
          prec:matchfix
          prec:inmatchfix)

  (begin

    (@ include-raw "gafoundry-lib/replacements-for-slib.scm")

    (@ include-raw
       "sed 's/^\x28;require /;;;\x28;require /' \
        gafoundry-lib/alist.scm \
        gafoundry-lib/strsrch.scm \
        gafoundry-lib/prec.scm|")

    ))
